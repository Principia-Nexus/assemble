# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=assemble
JWT_SECRET=change-me-to-a-long-random-string
DEMO_PASSWORD=change-me
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=

# Optional: Claude model (defaults to claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional: voice input (Whisper). Without it the mic returns "not configured".
# OPENAI_API_KEY=

# Optional: real email. Without SMTP_HOST, emails are written to the server log.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@example.com
# EMAIL_FROM_NAME=Assemble

# Optional: where uploaded PDFs and photos are kept (defaults to apps/api/data/objects)
# STORAGE_DIR=

# Optional: pilot paywall. Without STRIPE_SECRET_KEY there is no paywall.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MODE=test
